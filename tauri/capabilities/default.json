{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main webview window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-emit",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "opener:default",
    "dialog:default",
    "shell:allow-open",
    "clipboard-manager:allow-write-text",
    "process:default",
    "updater:default",
    "window-state:default"
  ]
}