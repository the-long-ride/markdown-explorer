{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markdown Explorer",
  "version": "1.6.4",
  "identifier": "com.the-long-ride.markdown-explorer",
  "build": {
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "the-long-ride",
    "copyright": "Copyright © 2026 the-long-ride",
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/explorer-hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://updates.the-long-ride.dev/markdown-explorer/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "__TAURI_UPDATER_PUBLIC_KEY__",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
