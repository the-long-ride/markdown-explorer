{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markdown Explorer",
  "version": "1.6.0",
  "identifier": "com.the-long-ride.markdown-explorer",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeBuildCommand": {
      "script": "pnpm run prepare:document-sidecar",
      "cwd": "."
    },
    "beforeDevCommand": {
      "script": "pnpm run prepare:document-sidecar",
      "cwd": ".",
      "wait": true
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "the-long-ride",
    "copyright": "Copyright \u00a9 2026 the-long-ride",
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "externalBin": [
      "binaries/markdown-them-node"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/explorer-hooks.nsh"
      }
    },
    "resources": {
      "sidecar/mdthem-sidecar/dist/": "document-sidecar/"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://updates.the-long-ride.dev/markdown-explorer/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "PLACEHOLDER_PUBKEY_REPLACE_BEFORE_RELEASE",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
