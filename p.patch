+/* Raw Grid layout, inspired by visible documentation grids without copied branding */
+[data-theme-style="raw-grid"] .app,
+[data-theme-style="raw-grid"] .content {
+  background-image:
+    linear-gradient(var(--bd) 1px, transparent 1px),
+    linear-gradient(90deg, var(--bd) 1px, transparent 1px);
+  background-size: 32px 32px;
+  background-position: -1px -1px;
+}
+
+[data-theme-style="raw-grid"] .topbar,
+[data-theme-style="raw-grid"] .desktop-tabbar,
+[data-theme-style="raw-grid"] .sidebar,
+[data-theme-style="raw-grid"] .toc-panel,
+[data-theme-style="raw-grid"] .mdn-section,
+[data-theme-style="raw-grid"] .mdn-codeblock,
+[data-theme-style="raw-grid"] .mdn-table-scroll,
+[data-theme-style="raw-grid"] .settings-card,
+[data-theme-style="raw-grid"] .modal {
+  border: var(--stroke-w) solid var(--bd-s);
+  border-radius: 0;
+  box-shadow: none;
+}
+
+[data-theme-style="raw-grid"] .topbar,
+[data-theme-style="raw-grid"] .desktop-tabbar {
+  border-left: 0;
+  border-right: 0;
+  border-top: 0;
+}
+
+[data-theme-style="raw-grid"] .body {
+  gap: 0;
+  padding: 0;
+}
+
+[data-theme-style="raw-grid"] .sidebar,
+[data-theme-style="raw-grid"] .toc-panel {
+  border-top: 0;
+  border-bottom: 0;
+}
+
+[data-theme-style="raw-grid"] .mdn-section:nth-child(even) {
+  transform: translateX(6px);
+}
+
+[data-theme-style="raw-grid"] .btn,
+[data-theme-style="raw-grid"] input,
+[data-theme-style="raw-grid"] select,
+[data-theme-style="raw-grid"] textarea {
+  border-radius: 0;
+}
+
+[data-theme-style="raw-grid"] :focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 2px;
+}
