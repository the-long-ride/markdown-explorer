 .pet-theme-menu__option--pet-corgi {
   --pet-paw: url("../../assets/themes/pets/paws/corgi-paw.svg");
 }
+
+/* Grouped built-in theme menu */
+.theme-style-option--themes {
+  display: flex;
+  flex-direction: column;
+  align-items: stretch;
+  gap: 8px;
+}
+
+.theme-group-dropdown {
+  width: calc(100% - 68px);
+  min-width: 0;
+  margin-left: 68px;
+  position: relative;
+  z-index: 20;
+}
+
+.theme-group-select {
+  width: 100%;
+  min-width: 0;
+  height: 28px;
+  display: flex;
+  align-items: center;
+  gap: 7px;
+  border: var(--stroke-w) solid var(--bd-s);
+  border-radius: var(--r);
+  background: var(--bg-e);
+  color: var(--tx);
+  font-family: var(--font-ui);
+  font-size: 11px;
+  font-weight: 700;
+  padding: 0 8px;
+  cursor: pointer;
+  outline: none;
+}
+
+.theme-group-select:hover,
+.theme-group-select:focus-visible {
+  background: var(--bg-h);
+  border-color: var(--accent);
+  box-shadow: var(--focus-ring);
+}
+
+.theme-group-select__label {
+  flex: 1;
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  text-align: left;
+}
+
+.theme-group-dropdown.is-open .pet-theme-select__chevron {
+  transform: rotate(180deg);
+}
+
+.theme-group-menu {
+  position: absolute;
+  left: 0;
+  right: 0;
+  bottom: calc(100% + 5px);
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  max-height: min(320px, 52vh);
+  overflow-y: auto;
+  padding: 5px;
+  border: var(--stroke-w) solid var(--bd-s);
+  border-radius: var(--r-md);
+  background: var(--bg-s);
+  color: var(--tx);
+  box-shadow: var(--sh-lg);
+  z-index: 2000;
+}
+
+.theme-group-menu[hidden] {
+  display: none;
+}
+
+.theme-group-menu__option {
+  width: 100%;
+  min-width: 0;
+  display: grid;
+  grid-template-columns: 18px minmax(0, 1fr);
+  align-items: center;
+  gap: 8px;
+  border: 0;
+  border-radius: calc(var(--r) - 2px);
+  background: transparent;
+  color: var(--tx2);
+  font-family: var(--font-ui);
+  text-align: left;
+  padding: 7px 8px;
+  cursor: pointer;
+}
+
+.theme-group-menu__option:hover,
+.theme-group-menu__option:focus-visible {
+  background: var(--bg-h);
+  color: var(--tx);
+  outline: none;
+}
+
+.theme-group-menu__option.is-selected {
+  background: var(--accent-dim);
+  color: var(--accent-text);
+}
+
+.theme-group-menu__swatch {
+  width: 16px;
+  height: 16px;
+  border: var(--stroke-w) solid var(--bd-s);
+  border-radius: 4px;
+  background: linear-gradient(135deg, var(--accent), var(--chart-2));
+}
+
+.theme-group-menu__copy {
+  min-width: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+}
+
+.theme-group-menu__label {
+  font-size: 11px;
+  font-weight: 800;
+  color: inherit;
+}
+
+.theme-group-menu__desc {
+  font-size: 9.5px;
+  line-height: 1.3;
+  color: var(--tx2);
+}
+
+.theme-style-option--neon-voltage .theme-style-option__swatch span:first-child,
+.theme-group-menu__option--neon-voltage .theme-group-menu__swatch {
+  background: linear-gradient(135deg, #ff6b6b 0%, #28e7d4 52%, #b75cff 100%);
+}
+
+.theme-style-option--raw-grid .theme-style-option__swatch span:first-child,
+.theme-group-menu__option--raw-grid .theme-group-menu__swatch {
+  border-radius: 0;
+  background:
+    linear-gradient(#ff6a22 1px, transparent 1px),
+    linear-gradient(90deg, #ff6a22 1px, #151515 1px);
+  background-size: 6px 6px;
+}
diff --git a/ui/src/styles/global/global-theme-raw-grid.css b/ui/src/styles/global/global-theme-raw-grid.css
