{
  "name": "markdown-explorer-desktop",
  "version": "1.5.3",
  "description": "Markdown Explorer - Transforms your markdown documents into a premium, interactive web-app experience.",
  "homepage": "https://github.com/the-long-ride/markdown-explorer",
  "author": {
    "name": "The Long Ride",
    "email": "info@thelongride.com"
  },
  "publisher": "the-long-ride",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:nsis": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "dist:win-zip": "electron-builder --win zip",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.thelongride.markdownexplorer",
    "productName": "Markdown Explorer",
    "electronVersion": "42.2.0",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/**"
    ],
    "compression": "normal",
    "files": [
      "*.js",
      "package.json",
      {
        "from": "../ui/dist",
        "to": "ui/dist"
      },
      {
        "from": "../ui/assets/logos",
        "to": "ui/assets/logos"
      }
    ],
    "win": {
      "target": [
        {
          "arch": ["x64"],
          "target": "nsis"
        },
        {
          "arch": ["x64"],
          "target": "portable"
        },
        {
          "arch": ["x64"],
          "target": "zip"
        }
      ],
      "icon": "../ui/assets/logos/logo-512.png"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Utility",
      "icon": "../ui/assets/logos/logo-512.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "../ui/assets/logos/logo-512.png",
      "category": "public.app-category.developer-tools"
    },
    "nsis": {
      "oneClick": false,
      "installerIcon": "../ui/assets/logos/logo-512.png",
      "shortcutName": "Markdown Explorer",
      "uninstallerIcon": "../ui/assets/logos/logo-512.png",
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "${productName} ${version}.${ext}"
    }
  },
  "dependencies": {
    "@the-long-ride/markdown-them": "^1.3.0",
    "v8-compile-cache": "^2.4.0"
  }
}
