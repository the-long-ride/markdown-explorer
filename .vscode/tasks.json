{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "watch",
      "type": "shell",
      "command": "npm run watch",
      "problemMatcher": "$tsc-watch",
      "isBackground": true,
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "compile",
      "type": "shell",
      "command": "npm run compile",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "group": "build"
    },
    {
      "label": "tauri:dev-frontend",
      "type": "shell",
      "command": "if ((Get-NetTCPConnection -LocalPort 5173 -State Listen -ErrorAction SilentlyContinue)) { Write-Host 'VITE dev server ready in 0ms (already running)' } else { npm run dev --workspace=ui }",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*VITE.*|^.*already running.*",
          "endsPattern": "^.*ready in.*"
        }
      }
    }
  ]
}
