{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/vscode"],
      "outFiles": ["${workspaceFolder}/vscode/out/**/*.js"],
      "preLaunchTask": "compile",
      "presentation": {
        "group": "debug",
        "order": 1
      }
    },
    {
      "name": "Electron Desktop App",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/ui/scripts/dev-electron.mjs",
      "args": ["--no-sandbox", "--in-process-gpu", "--disable-gpu"],
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "presentation": {
        "group": "debug",
        "order": 2
      },
      "outputCapture": "std",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Tauri Desktop App",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "start:tauri"],
      "console": "integratedTerminal",
      "presentation": {
        "group": "debug",
        "order": 3
      }
    },
    {
      "name": "Website",
      "type": "msedge",
      "request": "launch",
      "preLaunchTask": "dev: website-app",
      "url": "http://localhost:5173/markdown-explorer/",
      "webRoot": "${workspaceFolder}/website-app",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "/markdown-explorer/app/src/*": "${workspaceFolder}/website-app/src/*",
        "/markdown-explorer/app/@fs/*": "/*",
        "/markdown-explorer/app/node_modules/*": "${workspaceFolder}/node_modules/*"
      },
      "presentation": {
        "group": "debug",
        "order": 5
      }
    }
  ]
}
