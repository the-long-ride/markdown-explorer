{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vscode"
      ],
      "outFiles": [
        "${workspaceFolder}/vscode/out/**/*.js"
      ],
      "preLaunchTask": "watch"
    },
    {
      "name": "Debug Desktop App",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/desktop",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
      "windows": {
        "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron.cmd"
      },
      "args": [
        "."
      ],
      "outFiles": [
        "${workspaceFolder}/vscode/out/**/*.js"
      ],
      "preLaunchTask": "compile"
    },
    {
      "name": "Debug Tauri Desktop (CodeLLDB)",
      "type": "lldb",
      "request": "launch",
      "preLaunchTask": "tauri:dev-frontend",
      "cargo": {
        "args": [
          "build",
          "--manifest-path=${workspaceFolder}/desktop-tauri/src-tauri/Cargo.toml"
        ],
        "filter": {
          "name": "markdown-explorer",
          "kind": "bin"
        }
      },
      "cwd": "${workspaceFolder}/desktop-tauri/src-tauri"
    }
  ]
}
