{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vscode"
      ],
      "outFiles": [
        "${workspaceFolder}/vscode/out/**/*.js"
      ],
      "preLaunchTask": "watch"
    },
    {
      "name": "Electron Desktop App",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/electron",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
      "windows": {
        "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron.cmd"
      },
      "args": [
        "."
      ],
      "outFiles": [
        "${workspaceFolder}/vscode/out/**/*.js"
      ],
      "preLaunchTask": "compile"
    },
    {
      "name": "Tauri Desktop App",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm run start:tauri"
    },
    {
      "name": "Web Demo",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "preLaunchTask": "dev: website-app",
      "url": "http://localhost:5173/markdown-explorer/app/",
      "webRoot": "${workspaceFolder}/website-app",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "/markdown-explorer/app/src/*": "${workspaceFolder}/website-app/src/*",
        "/markdown-explorer/app/@fs/F:/my-repos/markdown-explorer/*": "${workspaceFolder}/*",
        "/markdown-explorer/app/node_modules/*": "${workspaceFolder}/node_modules/*"
      }
    }
  ]
}
