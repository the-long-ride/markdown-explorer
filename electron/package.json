{
  "name": "markdown-explorer-electron",
  "version": "1.6.5",
  "description": "Markdown Explorer - Transforms your markdown documents into a premium, interactive web-app experience.",
  "homepage": "https://github.com/the-long-ride/markdown-explorer",
  "author": {
    "name": "the-long-ride",
    "email": "info@thelongride.com"
  },
  "publisher": "the-long-ride",
  "desktopName": "markdown-explorer",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:nsis": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "dist:win-zip": "electron-builder --win zip",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.7"
  },
  "build": {
    "appId": "com.thelongride.markdownexplorer",
    "productName": "Markdown Explorer",
    "copyright": "Copyright © 2026 the-long-ride",
    "electronVersion": "43.2.0",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/**"
    ],
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown document",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "text/markdown"
      },
      {
        "ext": "mdx",
        "name": "MDX document",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "application/x-markdown-explorer-mdx"
      }
    ],
    "compression": "normal",
    "files": [
      "main.js",
      "package.json",
      "core/**/*.js",
      "fonts/**/*.js",
      "window/**/*.js",
      "workspace/**/*.js",
      "search/**/*.js",
      "render/document-converter.js",
      "update/**/*.js",
      "preload/**/*.js",
      "perf/**/*.js",
      "youtube/**/*.js",
      {
        "from": "../ui/dist",
        "to": "ui/dist"
      },
      {
        "from": "../ui/assets/logos",
        "to": "ui/assets/logos"
      }
    ],
    "win": {
      "target": [
        {
          "arch": [
            "x64"
          ],
          "target": "nsis"
        },
        {
          "arch": [
            "x64"
          ],
          "target": "portable"
        },
        {
          "arch": [
            "x64"
          ],
          "target": "zip"
        }
      ],
      "icon": "../ui/assets/logos/logo-512.png",
      "artifactName": "${productName}.${ext}"
    },
    "linux": {
      "syncDesktopName": true,
      "mimeTypes": [
        "inode/directory"
      ],
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Utility",
      "icon": "../ui/assets/logos/logo-512.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "../ui/assets/logos/logo-512.png",
      "category": "public.app-category.developer-tools"
    },
    "nsis": {
      "oneClick": false,
      "include": "build/installer.nsh",
      "shortcutName": "Markdown Explorer",
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createStartMenuShortcut": false,
      "createDesktopShortcut": false,
      "artifactName": "${productName} Setup.${ext}",
      "runAfterFinish": false
    },
    "portable": {
      "artifactName": "${productName} Portable.${ext}"
    }
  },
  "dependencies": {
    "@the-long-ride/markdown-them": "^1.3.2",
    "v8-compile-cache": "^2.4.0"
  }
}
