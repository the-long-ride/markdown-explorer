# Package only the VS Code host bundle and its two externalized runtime helpers.
out/**
!out/vscode/src/core/extension.bundle.js
!out/vscode/src/vendor/markdown-them.cjs
!out/node_modules/yaml/index.js
!ui/dist/
!ui/dist/**
ui/assets/**
!ui/assets/icons/markdown-explorer-dark-stroke.svg
!ui/assets/icons/markdown-explorer-light-stroke.svg
!ui/assets/logos/logo-500.png

# TypeScript configurations and Source Code
**/tsconfig.json
tsconfig.tsbuildinfo
src/**

# Test files and test sample documents
**/test/**
**/scripts/**

# Dependency folder
**/node_modules/**

# Git, Agent, GitHub workflows, and VS Code development configs
**/.git/**
**/.gitignore
**/.gitattributes
**/.github/**
**/.vscode/**
**/.agent/**
**/package-lock.json

# Packaged extension binaries
**/*.vsix

# Raw large assets (logo-128.png and logo-500.png are used instead)
**/ui/assets/logos/logo.png

# Mockups and screenshots (only used in README on GitHub)
**/media/**

# UI source code and dev configurations (only dist/ and assets/ are needed at runtime)
**/ui/src/**
**/ui/node_modules/**
**/ui/package.json
**/ui/package-lock.json
**/ui/tsconfig.json
**/ui/vite.config.ts
**/ui/index.html
**/ui/js/**
**/ui/css/**
**/ui/panel.html
ui/dist/assets/*.ttf
ui/assets/fonts/**
**/*.ttf

# Workspace Insights is not a VS Code capability; its host adapters are for other runtimes.
out/vscode/src/core/panelInsights.js
out/vscode/src/core/panelInsights.js.map
out/vscode/src/core/panelInsights.d.ts
out/vscode/src/core/panelInsightsExternal.js
out/vscode/src/core/panelInsightsExternal.js.map
out/vscode/src/core/panelInsightsExternal.d.ts
**/panelInsights.*
**/panelInsightsExternal.*

# The renderer lazy chunks are unreachable in the VS Code capability boundary.
ui/dist/assets/WorkspaceInsightsEntry.js
ui/dist/assets/insights.worker-*.js
